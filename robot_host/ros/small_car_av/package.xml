<?xml version="1.0"?>
<package format="3">
  <name>small_car_av</name>
  <version>0.2.0</version>
  <description>ROS 2 camera and ALSA audio nodes for the small car.</description>
  <maintainer email="small-car@example.com">small_car</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>libasound2-dev</build_depend>
  <depend>rclcpp</depend>
  <depend>small_car_interfaces</depend>

  <exec_depend>image_transport</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
